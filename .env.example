# Configuracao publica do cliente Supabase usada pelo frontend.
# A anon key pode ser exposta no bundle; nunca coloque a service role key aqui.
VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Origem publica da aplicacao em producao (https://seu-dominio).
# Cadastrar tambem /login e /reset-password em Authentication > URL Configuration.
# Em desenvolvimento, omitir para usar a origem atual do navegador.
VITE_APP_URL=

# Token da brapi.dev — usado APENAS em scripts de seed local (scripts/seed-price-history.mjs).
# Em produção, configure via: supabase secrets set BRAPI_KEY=<valor> --project-ref <ref>
# Obtenha em: https://brapi.dev/dashboard
BRAPI_KEY=your-brapi-token-here

# API key da bolsai.dev — usada pela Edge Function sync-bolsai-fundamentals.
# Em produção, configure via: supabase secrets set BOLSAI_KEY=<valor> --project-ref <ref>
# Obtenha em: https://usebolsai.com/dashboard
BOLSAI_KEY=your-bolsai-key-here

# Backend only: local Edge env / Supabase secrets. Never prefix with VITE_.
ALPHA_VANTAGE_API_KEY=
MARKETSTACK_API_KEY=
# Additional accounts, maximum 8 distinct keys. Do not repeat keys of the same account.
MARKETSTACK_API_KEYS=
MARKETSTACK_API_KEY_2=
MARKETSTACK_API_KEY_3=
MARKETSTACK_API_KEY_4=
MARKETSTACK_API_KEY_5=
MARKETSTACK_API_KEY_6=
MARKETSTACK_API_KEY_7=
MARKETSTACK_API_KEY_8=
